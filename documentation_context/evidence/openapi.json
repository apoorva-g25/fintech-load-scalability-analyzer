          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "transaction_count": {
            "type": "integer",
            "title": "Transaction Count"
          },
          "workload_type": {
            "type": "string",
