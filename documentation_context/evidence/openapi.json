          "workload_type": {
            "type": "string",
            "pattern": "^(domestic|international|mixed)$",
            "title": "Workload Type",
            "default": "mixed"
          },
          "processing_mode": {
            "type": "string",
            "pattern": "^(sequential|concurrent)$",
            "title": "Processing Mode",
            "default": "concurrent"
          },
          "concurrency_limit": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Concurrency Limit",
            "default": 50
          },
          "intl_percentage": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Intl Percentage",
            "default": 50.0
          },
          "random_seed": {
            "type": "integer",
            "title": "Random Seed",
            "default": 42
          },
          "fraud_config": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fraud Config"
          },
          "fx_config": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fx Config"
          },
          "notification_config": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notification Config"
          }
        },
        "type": "object",
        "title": "TestRunCreate"
