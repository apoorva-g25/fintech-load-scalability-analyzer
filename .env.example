# FinTech System Load & Scalability Analyzer Environment Configuration
PROJECT_NAME="FinTech System Load & Scalability Analyzer"
VERSION="1.0.0"
API_V1_STR="/api"
DATABASE_URL="sqlite:///./fintech_analyzer.db"
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Financial Defaults
DOMESTIC_CURRENCY="INR"
DEFAULT_FX_FEE_PERCENTAGE=1.00

# Fraud Detection Defaults
FRAUD_AMOUNT_THRESHOLD=250000.00
FRAUD_VELOCITY_WINDOW_SECONDS=60
FRAUD_VELOCITY_MAX_TXNS=5
FRAUD_PROBABILISTIC_RATE=0.015

# Microservice Concurrency & Worker Defaults
DEFAULT_MAX_CONCURRENCY=50
DEFAULT_NOTIFICATION_WORKERS=4
NOTIFICATION_QUEUE_MAX_SIZE=50000

# Simulated Microservice Latencies (ms)
BASE_PAYMENT_DELAY_MS=5.0
BASE_FX_DELAY_MS=8.0
BASE_FRAUD_DELAY_MS=6.0
BASE_NOTIFICATION_DELAY_MS=12.0
